# SatQuery AI Environment Variables Example
# Copy this file to .env and configure as needed.

# Backend Configuration
PORT=8000
DEVICE=auto
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Vision-Language Model API Keys
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# Local SatQuery Chatbot via LM Studio (OpenAI-compatible local endpoint)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=
LMSTUDIO_TIMEOUT=120.0
LMSTUDIO_CONNECT_TIMEOUT=2.0

# Pluggable Local Checkpoint Paths (Optional; falls back to baseline when absent)
RS_VLM_MODEL_ID=microsoft/Florence-2-base
RS_VLM_CHECKPOINT_PATH=models/weights/florence_2_base/
RS_VLM_DEVICE=cpu
RS_VLM_DTYPE=float32

# Bi-Temporal Change Detection Model Configuration (BIT-CD)
CHANGE_MODEL_ID=BIT-CD
CHANGE_MODEL_CHECKPOINT_PATH=models/weights/bit_cd.pth
CHANGE_MODEL_DEVICE=cpu
CHANGE_MODEL_DTYPE=float32
RS_CHANGE_CHECKPOINT_PATH=models/weights/bit_cd.pth

# Open-Vocabulary Visual Grounding Model Configuration (OWL-ViT)
GROUNDING_MODEL_ID=google/owlvit-base-patch32
GROUNDING_MODEL_CHECKPOINT_PATH=models/weights/owlvit_base/
GROUNDING_MODEL_DEVICE=cpu
GROUNDING_MODEL_DTYPE=float32
RS_GROUNDING_CHECKPOINT_PATH=models/weights/owlvit_base/

# Frontend Configuration (in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
