# SatQuery AI Backend Environment Configuration

# Server & Runtime
PORT=8000
DEVICE=cpu
PYTHON_VERSION=3.11.9

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (no wildcards with credentials)
CORS_ORIGINS=https://sat-query-gamma.vercel.app,http://localhost:3000,http://localhost:5173

# Hugging Face Spaces Qwen-VL Inference
HF_SPACE_ID=Astro406/satquery-qwen-vl
HF_API_NAME=/predict
HF_REQUEST_TIMEOUT=65
HF_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
# HF_TOKEN is optional for public spaces
# HF_TOKEN=hf_...

# Optional Legacy / External Foundation Model Keys
# GEMINI_API_KEY=
